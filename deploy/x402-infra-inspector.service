[Unit]
Description=x402 Infrastructure Inspector
Documentation=file:///opt/x402-infra-inspector/current/docs/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=x402-inspector
Group=x402-inspector
WorkingDirectory=/opt/x402-infra-inspector/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/x402-infra-inspector/environment
ExecStart=/usr/bin/node /opt/x402-infra-inspector/current/dist/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillSignal=SIGTERM
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
