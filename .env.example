# Runtime
LISTEN_HOST=127.0.0.1
PORT=4021
APP_ENV=development
LOG_LEVEL=info
PUBLIC_BASE_URL=https://x402.pipeforge.tech
X402_NETWORK=testnet
X402_ASSET_ID=10458941

# Enable only after configuring and verifying a TestNet receiver.
PAYMENTS_ENABLED=false
X402_PAY_TO=
X402_PRICE_USD=$0.02
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_CHALLENGE_TAG=x402-global-challenge

# Isolated payer client (never put a mnemonic in this file)
X402_RESOURCE_URL=http://127.0.0.1:4021/api/v1/inspect?host=example.com
X402_EXPECTED_PAYER=
X402_EXPECTED_RECEIVER=
# AVM_MNEMONIC_FILE is supplied at runtime and must point outside the repository.

# Inspection bounds
INSPECTION_TIMEOUT_MS=5000
INSPECTION_MAX_REDIRECTS=5
