{
  "name": "x402-infra-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A bounded, x402-paid public infrastructure inspection API on Algorand.",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "client:testnet": "tsx scripts/testnet-payer.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "10.0.0-alpha.46",
    "@hono/node-server": "^2.1.1",
    "@x402-avm/extensions": "^2.6.1",
    "@x402/avm": "^2.26.0",
    "@x402/core": "^2.26.0",
    "@x402/fetch": "^2.26.0",
    "@x402/hono": "^2.26.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
